# Server-side Gemini key (fallback when a visitor hasn't added their own in Settings).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Set to true to let visitors without their own key use the server key above, capped at
# SHARED_KEY_DAILY_LIMIT requests per visitor per day (default 30; needs the Supabase
# settings below plus QUOTA_SECRET, whose SHA-256 goes in private.settings — see
# supabase/migrations/0002). Leave empty so strangers never spend your quota.
NEXT_PUBLIC_SHARED_KEY=
QUOTA_SECRET=

# Optional model overrides (defaults: gemini-3.1-flash-lite answers (500/day free), falling back to gemini-3.6-flash, gemini-3.8-flash and gemini-flash-latest; gemini-embedding-001 embeddings).
# Leave commented to use the defaults in lib/gemini.ts. Changing the embedding model
# makes vectors already stored in users' browsers incompatible.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional accounts + cloud sync (Supabase). Leave unset for a local-only app.
# Schema: supabase/migrations/. The publishable key (sb_publishable_…) is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Sign-in providers enabled in Supabase → Authentication → Providers (comma-separated).
NEXT_PUBLIC_AUTH_PROVIDERS=github
