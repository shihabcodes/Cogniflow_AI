# Server-side Gemini key (fallback when a visitor hasn't added their own in Settings).
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Set to true (or 1) to let visitors without their own key use the server key above.
# Leave unset/empty on public deployments so strangers never spend your quota.
ALLOW_SERVER_KEY=

# Optional model overrides (defaults: gemini-3.6-flash answers, gemini-embedding-001 embeddings).
# Leave commented to use the defaults in lib/gemini.ts. Changing the embedding model
# makes vectors already stored in users' browsers incompatible.
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional accounts + cloud sync (Supabase). Leave unset for a local-only app.
# Schema: supabase/migrations/. The anon key is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sign-in providers enabled in Supabase → Authentication → Providers (comma-separated).
NEXT_PUBLIC_AUTH_PROVIDERS=github
